# Never commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated browser origins allowed by CORS, e.g. http://localhost:5173
# Leave empty to disable CORS.
CORS_ORIGINS=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=oruvia
# Set to true for managed databases that require TLS (e.g. Neon)
DB_SSL=false
# Log TypeORM warnings and migrations in addition to errors
DB_LOGGING=false
# Automatically run pending migrations on application bootstrap (recommended for cloud/Render)
DB_MIGRATIONS_RUN=false

# Reverse Proxy configuration (Express trust proxy)
# Set to '1' if behind a single reverse proxy (e.g. AWS ALB, Cloudflare).
# Leave empty to disable and prevent client IP spoofing via X-Forwarded-For.
TRUST_PROXY=

# Authentication (Seekers JWT)
# Must be at least 32 characters. In production, dev default is strictly rejected.
JWT_SECRET=super-secret-seeker-jwt-key-for-dev-32chars
JWT_EXPIRES_IN=1d

# Email Delivery
# Options: console (simulated delivery for test/dev) | smtp (live SMTP transport)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@oruvia.com

# SMTP Settings (Required when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# KYC Document Storage
# Options: local (dev/test fallback, disk under KYC_UPLOAD_DIR) | cloudinary (production, required)
KYC_STORAGE_PROVIDER=local
KYC_UPLOAD_DIR=uploads/kyc

# Cloudinary Settings (Required when KYC_STORAGE_PROVIDER=cloudinary)
# Private folder for identity documents.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_KYC_FOLDER=oruvia/kyc
