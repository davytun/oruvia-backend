# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed by CORS, e.g. http://localhost:5173
# Leave empty to disable CORS.
CORS_ORIGINS=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=oruvia
# Set to true for managed databases that require TLS (e.g. Neon)
DB_SSL=false
# Log TypeORM warnings and migrations in addition to errors
DB_LOGGING=false
