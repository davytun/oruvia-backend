{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "APP_NAME": "Oruvia",
    "APP_ENV": "production",
    "APP_URL": "https://api.oruvia.workers.dev",
    "FRONTEND_URL": "http://localhost:3000",
    "EMAIL_FROM": "Oruvia <noreply@oruvia.ng>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oruvia-db",
      "database_id": "2a6c11b7-5827-4699-b084-0e5e66242938",
      "migrations_dir": "src/database/migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
